{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fancy-knowing",
  "main": "worker/index.mjs",
  "compatibility_date": "2026-10-26",
  "workers_dev": true,
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": true },
  "vars": { "OPENAI_MODEL": "gpt-4.1-mini", "QUIZ_LIMITS_ENABLED": "false", "APP_URL": "https://fancy-knowing.nikki0radz.workers.dev" },
  "d1_databases": [{
    "binding": "DB", "database_name": "fancy-knowing-db",
    "database_id": "f2b9470b-8ca7-4f75-9493-3ac2bfc3bf8b",
    "migrations_dir": "migrations"
  }],
  "triggers": { "crons": ["*/5 * * * *"] }
}
