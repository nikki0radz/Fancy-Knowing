OPENAI_API_KEY=put-your-key-in-the-ignored-.dev.vars-file-only
SIGNUP_CODE=choose-a-private-code-for-you-and-your-mum

# Optional: enables recovery/confirmation email once configured
RESEND_API_KEY=your-resend-sending-api-key
EMAIL_FROM=Fancy Knowing <onboarding@resend.dev>

# Alternative to Resend: Gmail via the provided Google Apps Script
# EMAIL_WEBHOOK_URL=https://script.google.com/macros/s/your-deployment-id/exec
# EMAIL_WEBHOOK_SECRET=your-new-random-connection-secret-at-least-32-characters
