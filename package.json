{
  "name": "fancy-knowing",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "npm run build && wrangler dev",
    "deploy": "npm run build && node scripts/check-deploy.mjs && wrangler d1 migrations apply DB --remote && wrangler deploy",
    "db:local": "wrangler d1 migrations apply DB --local",
    "db:remote": "wrangler d1 migrations apply DB --remote",
    "test": "node --test tests/core.test.mjs tests/integration.test.mjs"
  },
  "devDependencies": {
    "wrangler": "4.152.0",
    "miniflare": "5.20261019.2-beta"
  }
}
